<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 基础主题（带ActionBar） -->
    <style name="Theme.PasswordManager" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">?attr/colorPrimary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- 无ActionBar主题（用于有自定义Toolbar的页面） -->
    <style name="Theme.PasswordManager.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">?attr/colorPrimary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Splash页面主题 -->
    <style name="Theme.PasswordManager.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">?attr/colorPrimary</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="Theme.PasswordManager.NoActionBar.Green" parent="Theme.PasswordManager.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
    </style>

    <style name="Theme.PasswordManager.NoActionBar.Purple" parent="Theme.PasswordManager.NoActionBar">
        <item name="colorPrimary">@color/primary_purple</item>
    </style>

    <style name="Theme.PasswordManager.NoActionBar.Red" parent="Theme.PasswordManager.NoActionBar">
        <item name="colorPrimary">@color/primary_red</item>
    </style>

    <style name="Theme.PasswordManager.Splash.Green" parent="Theme.PasswordManager.Splash">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="android:windowBackground">@color/primary_green</item>
    </style>

    <style name="Theme.PasswordManager.Splash.Purple" parent="Theme.PasswordManager.Splash">
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="android:windowBackground">@color/primary_purple</item>
    </style>

    <style name="Theme.PasswordManager.Splash.Red" parent="Theme.PasswordManager.Splash">
        <item name="colorPrimary">@color/primary_red</item>
        <item name="android:windowBackground">@color/primary_red</item>
    </style>

</resources>
