<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PasswordManager"
        tools:targetApi="31">

        <!-- 启动页 -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PasswordManager.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 登录页 - 无ActionBar -->
        <activity
            android:name=".ui.LoginActivity"
            android:theme="@style/Theme.PasswordManager.NoActionBar"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- 注册页 - 无ActionBar -->
        <activity
            android:name=".ui.RegisterActivity"
            android:theme="@style/Theme.PasswordManager.NoActionBar"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- 主页 - 无ActionBar（使用自定义Toolbar） -->
        <activity
            android:name=".ui.MainActivity"
            android:theme="@style/Theme.PasswordManager.NoActionBar" />

        <!-- 添加/编辑密码页 - 无ActionBar（使用自定义Toolbar，结构与主页一致） -->
        <activity
            android:name=".ui.AddEditPasswordActivity"
            android:theme="@style/Theme.PasswordManager.NoActionBar"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- 密码生成器页 - 无ActionBar（使用自定义Toolbar，结构与主页一致） -->
        <activity
            android:name=".ui.PasswordGeneratorActivity"
            android:theme="@style/Theme.PasswordManager.NoActionBar" />

        <!-- 设置页 - 无ActionBar（使用自定义Toolbar，结构与主页一致） -->
        <activity
            android:name=".ui.SettingsActivity"
            android:theme="@style/Theme.PasswordManager.NoActionBar" />

        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.PasswordManager.NoActionBar" />

        <service
            android:name=".autofill.PasswordAutofillService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

    </application>

</manifest>
